{
  "manifest_version": 2,
  "name": "Thunderbird Background",
  "version": "1.1.4",
  "description": "Hide the last main mail window to the Linux tray while continuing to receive mail in the background; minimize if the tray is unavailable.",
  "browser_specific_settings": {
    "gecko": {
      "id": "background-local@thunderbird.local",
      "strict_min_version": "156.0",
      "strict_max_version": "*"
    }
  },
  "permissions": ["nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "experiment_apis": {
    "backgroundWindow": {
      "schema": "experiments/schema.json",
      "parent": {
        "events": ["startup"],
        "scopes": ["addon_parent"],
        "paths": [["backgroundWindow"]],
        "script": "experiments/api.js"
      }
    }
  }
}
